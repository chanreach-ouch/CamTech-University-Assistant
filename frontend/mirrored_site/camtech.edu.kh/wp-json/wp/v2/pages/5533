or-widget-spacer\" data-id=\"6d67451\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-top-column elementor-element elementor-element-9080f29\" data-id=\"9080f29\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-fcbc830 elementor-widget elementor-widget-text-editor\" data-id=\"fcbc830\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><span style=\"color: var( --e-global-color-primary ); font-family: var( --e-global-typography-primary-font-family ), Sans-serif; font-size: 20px; font-weight: var( --e-global-typography-primary-font-weight ); text-transform: none;\">Vision &amp; Missions<\/span><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8ff2afa elementor-widget elementor-widget-text-editor\" data-id=\"8ff2afa\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div data-id=\"84e80c0\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\"><div><div><p><span style=\"color: var( --e-global-color-text ); font-size: 16px; letter-spacing: 0em;\">The Faculty of Arts, Humanities, and Social Sciences aspires to lead in education, teaching and learning, research and innovation in the area of arts, humanities, social science and technology and to passionate commitment to their profession as well as to social development.<\/span><\/p><div><span style=\"font-size: 16px; color: var( --e-global-color-text ); letter-spacing: 0em;\">In order to accomplish our vision, we will put effort to:<\/span><\/div><div><ul style=\"font-size: 16px;\"><li>Encourage lecturers to provide high quality teaching, research-informed teaching, and applied high impact research and innovation, which also engages students.<\/li><li>Seek and maintain innovative teaching and learning practices in order to become a role model for good educational practices.<\/li><li>Transform our graduates with the mindset that encourages lifelong learning, integrity, creativity and innovation, and professionalism so that they can become leaders in the area of arts, humanities, social science and technology-enhanced learning;<\/li><li>To serve as a focal point of intellectual and academic exchange to enable local, national, and international collaboration on teaching and research in the area of arts, humanities, social science and technology-enhanced learning<\/li><\/ul><\/div><div>\u00a0<\/div><\/div><\/div><\/div>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-33 elementor-top-column elementor-element elementor-element-a6c5b1d\" data-id=\"a6c5b1d\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-af4c280 elementor-widget elementor-widget-text-editor\" data-id=\"af4c280\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p>contact<\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b220218 elementor-widget elementor-widget-text-editor\" data-id=\"b220218\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><b><a href=\"mailto:admissions@camtech.edu.kh\" target=\"_blank\" rel=\"noopener\">admissions@camtech.edu.k