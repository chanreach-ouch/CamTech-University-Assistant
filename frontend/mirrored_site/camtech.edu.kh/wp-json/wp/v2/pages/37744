             <td>~$10 &#8211; $20<\/td>\n                    <\/tr>\n                    <tr>\n                        <td>Internet<\/td>\n                        <td>~ $0 ( included )<\/td>\n                    <\/tr>\n                    <tr>\n                        <td>Transportation<\/td>\n                        <td>~ $40 &#8211; $100<\/td>\n                    <\/tr>\n                <\/tbody>\n            <\/table>\n\n            <div class=\"ct-acc-note\">\n                These estimates are based on living near campus in Chroy Chongvar. Costs may vary depending on your lifestyle and whether you choose city-center housing. ( <strong>Student Housing service available<\/strong> )<br><br>\n                All prices in this guide are shown in US dollars (USD) unless otherwise stated. Prices are approximate and subject to change.\n            <\/div>\n        <\/div>\n\n        <div class=\"ct-acc-right\">\n            <img decoding=\"async\" \n                src=\"https:\/\/camtech.edu.kh\/wp-content\/uploads\/2025\/12\/Condo-Rung-Rueng.jpeg\" \n                alt=\"Student Accommodation Building\" \n                class=\"ct-acc-img\"\n            >\n        <\/div>\n\n    <\/div>\n\n<\/div>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-512672d elementor-widget elementor-widget-spacer\" data-id=\"512672d\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c482019 e-con-full e-flex e-con e-child\" data-id=\"c482019\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7d9bd9c elementor-widget elementor-widget-html\" data-id=\"7d9bd9c\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<d