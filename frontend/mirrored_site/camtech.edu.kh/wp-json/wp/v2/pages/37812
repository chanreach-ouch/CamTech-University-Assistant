ottom: 6px;\r\n        line-height: 1.5;\r\n    }\r\n\r\n    \/* --- LINKS --- *\/\r\n    .ct-web-link {\r\n        display: inline-block;\r\n        color: #0066cc; \/* Standard Link Blue *\/\r\n        text-decoration: none;\r\n        font-weight: 600;\r\n        font-size: 14px;\r\n        margin-top: 5px;\r\n        transition: color 0.2s;\r\n    }\r\n\r\n    .ct-web-link:hover {\r\n        color: #0b2c6b; \/* Darker blue on hover *\/\r\n        text-decoration: underline;\r\n    }\r\n\r\n    \/* --- IMAGE --- *\/\r\n    .ct-health-img {\r\n        width: 100%;\r\n        height: auto;\r\n        border-radius: 4px;\r\n        box-shadow: 0 4px 10px rgba(0,0,0,0.1);\r\n        display: block;\r\n    }\r\n\r\n    \/* --- MOBILE RESPONSIVE --- *\/\r\n    @media (max-width: 768px) {\r\n        .ct-health-layout {\r\n            flex-direction: column;\r\n        }\r\n        .ct-health-right {\r\n            max-width: 100%;\r\n            width: 100%;\r\n            margin-bottom: 20px;\r\n            order: -1; \/* Puts image on top on mobile, remove if you want text first *\/\r\n        }\r\n    }\r\n<\/style>\r\n\r\n<div class=\"ct-health-wrapper\">\r\n    \r\n    <h2>Health Insurance in Cambodia<\/h2>\r\n    \r\n    <div class=\"ct-health-layout\">\r\n        \r\n        <div class=\"ct-health-left\">\r\n            \r\n            <div class=\"ct-provider-block\">\r\n                <span class=\"ct-provider-title\">Sovannaphum Life Assurance Plc. (Sovannaphum Insurance)<\/span>\r\n                <ul>\r\n                    <li>Offers a range of \u201cSMILE\u201d products such as SMILE Education Plans, SMILE Easy Protection, and Group Health.<\/li>\r\n                    <li>Premium pricing is not publicly listed\u2014students should contact Sovannaphum directly for quotes tailored to coverage needs.<\/li>\r\n                    <li>Convenient premium payment via banks, mobile wallets (ABA, Wing, TrueMoney), or local agents.<\/li>\r\n                <\/ul>\