 elementor-element-538d84b elementor-section-boxed elementor-section-gap-beside-yes elementor-section-height-default elementor-section-height-default elementor-section-column-vertical-align-stretch\" data-id=\"538d84b\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-cb3f3ed\" data-id=\"cb3f3ed\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6af449e elementor-widget elementor-widget-spacer\" data-id=\"6af449e\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-3e54ec9 elementor-section-boxed elementor-section-gap-beside-yes elementor-section-height-default elementor-section-height-default elementor-section-column-vertical-align-stretch\" data-id=\"3e54ec9\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-fd62b07\" data-id=\"fd62b07\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-f6615a6 elementor-widget elementor-widget-text-editor\" data-id=\"f6615a6\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p class=\"LO-normal\" style=\"text-align: justify;\"><span style=\"font-family: 'Times New Roman',serif;\">In the morning of December 6, 2021, with the permission from the Ministry of Education, Youth and Sport and in collaboration with the Principal of Hun Sen Sa\u2019ang High School, the team of Cambodia University of Technology and Science of Cambodia (CamTech) led by H.E. Dr. Khieng Sothy, CamTech President, organized an event on \u201cMajor and Career Counseling for Future Jobs\u201d for grade-12 Students of Hun Sen Sa\u2019ang High School in Sa\u2019ang District, Kandal Province. The main objectives of the event are to: 1) Provide an opportunity for grade-12 students to have a face-to-face counseling session with CamTech academic team on choosing a major for higher education; 2) Raise awareness of the current educational trends and future market demands; and 3) Promote grade-12 students\u2019 readiness for pursuing their higher degree.<\/span><\/p><p class=\"LO-normal\" style=\"text-align: justify;\"><span style=\"font-family: 'Times New Roman',serif;\">The number of the participants in this event was approximately 70 grade-12 students and some classroom teachers, and the event was held with strict observance of the guidelines from the Ministry of Education, Youth and Sport and the Ministry of Health to prevent the spread of Covid-19.<\/span><\/p><p class=\"LO-normal\" style=\"text-align: justify;\"><span style=\"font-family: 'Times New Roman',serif;\">The \u201cMajor and Career Counseling for Future Jobs\u201d is an important mission of CamTech in contributing with the Ministry of Education, Youth and Sport to raising the awareness and understanding of grade-12 students of how to select majors at higher education to respond to the current educational trends and future market demands in the era of Industrial Revolution 4.0 and ensure sustainable national economic development.<\/span><\/p><p class=\"LO-normal\" style=\"text-align: justify;\"><span style=\"font-family: 'Times New Roman', serif; color: var( --e-global-color-text ); font-weight: var( --e-global-typography-text-font-weight ); letter-spacing: 0em;\">CamTech would like to thank the Ministry of Education, Youth and Sport and the principal of Hun Sen Sa\u2019ang High School for allowing our team to have the opportunity to meet and consult with grade-12 students in a friendly atmosphere. This event provided many benefits to those grade 12 students in getting themselves prepared for their university life and the majors they should choose for higher education.<\/span><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-37d941d elementor-section-boxed elementor-section-gap-beside-yes elementor-section-height-default elementor-section-height-default elementor-section-column-vertical-align-stretch\" data-id=\"37d941d\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-70fe89e\" data-id=\"70fe89e\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-5607182 elementor-widget elementor-widget-spacer\" data-id=\"5607182\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-ae8b438 elementor-section-boxed elementor-section-gap-beside-yes elementor-section-height-default elementor-