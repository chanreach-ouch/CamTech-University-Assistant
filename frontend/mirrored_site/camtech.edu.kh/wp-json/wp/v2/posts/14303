; (CMGC).\u00a0 Chip Mong Group&#8217;s core values, particularly &#8220;Growing and Giving Back&#8221;, are well-aligned with CamTech&#8217;s objective of producing young talents in order to support the economic growth and welfare of Cambodia. Thus, CamTech University is pleased to announce a partnership with the Chip Mong Group to provide STEM Genius Scholarships, Internships, and Employment Opportunities for young potential Cambodian talents. Are you ready to join us?<\/p>\n","protected":false},"author":6,"featured_media":14306,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"footnotes":""},"categories":[179],"tags":[],"class_list":["post-14303","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news"],"acf":[],"_links":{"self":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14303","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/users\/6"}],"replies":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/comments?post=14303"}],"version-history":[{"count":5,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14303\/revisions"}],"predecessor-version":[{"id":14334,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14303\/revisions\/14334"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/media\/14306"}],"wp:attachment":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/media?parent=14303"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/categories?post=14303"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/tags?post=14303"}],"curies":[{"name":"wp","href":