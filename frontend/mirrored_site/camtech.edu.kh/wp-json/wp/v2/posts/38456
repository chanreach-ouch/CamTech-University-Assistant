ovation and Policy- \u17a0\u17c5\u1780\u17b6\u178f\u17cb\u1790\u17b6 ASIP) \u1780\u17d2\u179a\u17c4\u1798\u17a2\u1792\u17b7\u1794\u178f\u17b8 \u17af\u1780\u17a7\u178f\u17d2\u178f\u1798 \u17a0\u17c2\u1798 \u179c\u178e\u17d2\u178e\u178c\u17b8 \u179a\u178a\u17d2\u178b\u1798\u1793\u17d2\u178f\u17d2\u179a\u17b8\u1780\u17d2\u179a\u179f\u17bd\u1784\u17a7\u179f\u17d2\u179f\u17b6\u17a0\u1780\u1798\u17d2\u1798 \u179c\u17b7\u1791\u17d2\u1799\u17b6\u179f\u17b6\u179f\u17d2\u178f\u17d2\u179a \u1794\u1785\u17d2\u1785\u17c1\u1780\u179c\u17b7\u1791\u17d2\u1799\u17b6 \u1793\u17b7\u1784\u1793\u179c\u17b6\u1793\u17bb\u179c\u178f\u17d2\u178f\u1793\u17cd \u178a\u17c2\u179b\u179f\u1793\u17d2\u1793\u17b7\u179f\u17b8\u1791\u1793\u17c1\u17c7\u1794\u17b6\u1793\u1794\u17d2\u179a\u1796\u17d2\u179a\u17b9\u178f\u17d2\u178f\u17b7\u1791\u17c5\u1793\u17c5\u1790\u17d2\u1784\u17c3\u1791\u17b8\u17e3-\u17e4 \u1781\u17c2\u1792\u17d2\u1793\u17bc \u1786\u17d2\u1793\u17b6\u17c6\u17e2\u17e0\u17e2\u17e5 \u17d4\u179f\u1793\u17d2\u1793\u17b7\u179f\u17b8\u1791\u17a2\u1793\u17d2\u178f\u179a\u1787\u17b6\u178f\u17b7ASIP \u1795\u17d2\u178f\u17c4\u178f\u179f\u17c6\u1781\u17b6\u1793\u17cb\u179b\u17be\u17a2\u1797\u17b7\u1794\u17b6\u179b\u1780\u17b7\u1785\u17d2\u1785\u1793\u17c3\u1794\u1785\u17d2\u1785\u17c1\u1780\u179c\u17b7\u1791\u17d2\u1799\u17b6\u179c\u17c3\u1786\u17d2\u179b\u17b6\u178f \u1780\u17d2\u179a\u17c4\u1798\u179c\u17c1\u1791\u17b7\u1780\u17b6\u179a\u1796\u17b7\u1797\u17b6\u1780\u17d2\u179f\u17b6\u1796\u17b8\u1782\u17c4\u179b\u1793\u1799\u17c4\u1794\u17b6\u1799\u1793\u179c\u17b6\u1793\u17bb\u179c\u178f\u17d2\u178f\u1793\u17cd \u1793\u17b7\u1784\u1780\u17b6\u179a\u1795\u17d2\u179b\u17b6\u179f\u17cb\u1794\u17d2\u178f\u17bc\u179a\u1794\u1785\u17d2\u1785\u17c1\u1780\u179c\u17b7\u1791\u17d2\u1799\u17b6 \u17a0\u17be\u1799\u1794\u17d2\u179a\u1792\u17b6\u1793\u1794\u1791\u1780\u17d2\u1793\u17bb\u1784\u1786\u17d2\u1793\u17b6\u17c6\u1793\u17c1\u17c7 \u1782\u17ba\u179f\u17d2\u179c\u17c2\u1784\u179a\u1780\u178a\u17c6\u178e\u17c4\u17c7\u179f\u17d2\u179a\u17b6\u1799\u1794\u1789\u17d2\u17a0\u17b6\u1794\u17d2\u179a\u1788\u1798\u1787\u17b6\u179f\u17b6\u1780\u179b\u1780\u17d2\u1793\u17bb\u1784\u1780\u17b6\u179a\u1794\u17d2\u179a\u17be\u1794\u17d2\u179a\u17b6\u179f\u17cb \u1793\u17b7\u1784\u1782\u17d2\u179a\u1794\u17cb\u1782\u17d2\u179a\u1784\u1794\u1789\u17d2\u1789\u17b6\u179f\u17b7\u1794\u17d2\u1794\u1793\u17b7\u1798\u17b7\u178f\u17d2\u178f (AI) \u179a\u17c9\u17bc\u1794\u17bc\u178f \u179f\u17d2\u179c\u17d0\u1799\u1794\u17d2\u179a\u179c\u178f\u17d2\u178f\u17b7\u1780\u1798\u17d2\u1798 \u1793\u17b7\u1784\u1794\u17d2\u179a\u1796\u17d0\u1793\u17d2\u1792\u178c\u17b8\u1787\u17b8\u1790\u179b\u1794\u17d2\u179a\u1780\u1794\u178a\u17c4\u1799\u1791\u17c6\u1793\u17bd\u179b\u1781\u17bb\u179f\u178f\u17d2\u179a\u17bc\u179c \u178a\u17be\u1798\u17d2\u1794\u17b8\u1792\u17b6\u1793\u17b6\u178a\u179b\u17cb\u178a\u17c6\u178e\u17be\u179a\u1780\u17b6\u179a\u1793\u179c\u17b6\u1793\u17bb\u179c\u178f\u17d2\u178f\u1793\u17cd \u1797\u17d2\u1787\u17b6\u1794\u17cb\u1791\u17c5\u1793\u17b9\u1784\u1780\u17d2\u179a\u1798\u179f\u17b8\u179b\u1792\u1798\u17cc \u1796\u17b7\u1785\u17b6\u179a\u178e\u17b6\u178a\u179b\u17cb\u1794\u1789\u17d2\u17a0\u17b6\u179f\u1784\u17d2\u1782\u1798 \u1793\u17b7\u1784\u1780\u17b6\u179a\u178a\u17b6\u1780\u17cb\u1793\u17bc\u179c\u1780\u17b6\u179a\u17a2\u1793\u17bb\u179c\u178f\u17d2\u178f\u1782\u17c4\u179b\u1780\u17b6\u179a\u178e\u17cd\u1787\u17b6\u178a\u17be\u1798\u17d4 \u1799\u17be\u1784\u179f\u1784\u17d2\u1783\u17b9\u1798\u1790\u17b6 \u1780\u17b6\u179a\u1796\u17b7\u1797\u17b6\u1780\u17d2\u179f\u17b6\u1796\u17b8\u179f\u17c6\u178e\u17b6\u1780\u17cb\u179f\u17b6\u179f\u17d2\u178f\u17d2\u179a\u17b6\u1785\u17b6\u179a\u17d2\u1799 \u17a2\u17d2\u1793\u1780\u179f\u17d2\u179a\u17b6\u179c\u1787\u17d2\u179a\u17b6\u179c \u1793\u17b7\u179f\u17d2\u179f\u17b7\u178f\u1793\u17c1\u17c7\u1793\u17b9\u1784\u1791\u1791\u17bd\u179b\u1794\u17b6\u1793\u1793\u17bc\u179c\u179b\u1791\u17d2\u1792\u1795\u179b\u179b\u17d2\u17a