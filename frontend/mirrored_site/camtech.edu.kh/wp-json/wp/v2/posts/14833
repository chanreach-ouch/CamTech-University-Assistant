M careers.\u00a0A publication in 2016 by Saint Blanquat &amp; Associates, Co., Ltd. funded by the British Embassy in Phnom Penh lists the top 20 careers in Cambodia over the next 10 years, which include production line supervisors, automation technicians, architects, civil engineers, construction site supervisors, health and safety engineers, construction project managers, water supply experts, water sanitation experts, quality assurance specialists, chemists, public health analysts, doctors (general practitioners), medical laboratory technicians, psychologists, economists, actuaries, financial analysts, mechanics, network analysts, and software programmers. Related Events<\/p>\n","protected":false},"author":7,"featured_media":14835,"comment_status":"open","ping_status":"open","sticky":false,"template":"elementor_header_footer","format":"standard","meta":{"_acf_changed":false,"footnotes":""},"categories":[179],"tags":[],"class_list":["post-14833","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-news"],"acf":[],"_links":{"self":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14833","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/users\/7"}],"replies":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/comments?post=14833"}],"version-history":[{"count":3,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14833\/revisions"}],"predecessor-version":[{"id":14839,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/posts\/14833\/revisions\/14839"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/media\/14835"}],"wp:attachment":[{"href":"https:\/\/camtech.edu.kh\/wp-json\/wp\/v2\/media?parent=14833"}],"wp:term":[{"taxonomy":"category","embe